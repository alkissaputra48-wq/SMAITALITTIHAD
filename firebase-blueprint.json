{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Santri data record of SMA IT AL ITTIHAD",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nis": { "type": "string", "maxLength": 30 },
        "nisn": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 150 },
        "gender": { "type": "string", "enum": ["L", "P"] },
        "classId": { "type": "string", "maxLength": 50 },
        "parentName": { "type": "string", "maxLength": 150 },
        "parentPhone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "qrCodeData": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["aktif", "nonaktif", "mutasi"] },
        "createdDate": { "type": "string" }
      },
      "required": ["id", "nis", "name", "classId", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily real-time attendance record per student per session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentNis": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["hadir", "terlambat", "izin", "sakit", "alpa"] },
        "notes": { "type": "string", "maxLength": 300 },
        "method": { "type": "string", "enum": ["qr_scan", "manual", "rfid", "api_sync"] },
        "verifiedBy": { "type": "string" },
        "notifiedParent": { "type": "boolean" },
        "parentNotifiedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "date", "status", "categoryId"]
    },
    "AttendanceCategory": {
      "title": "AttendanceCategory",
      "description": "Daily schedule category like Sholat Dzuhur, Sholat Ashar, Presensi Pagi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "lateToleranceMinutes": { "type": "number" },
        "activeDays": { "type": "array" },
        "isRequired": { "type": "boolean" },
        "type": { "type": "string", "enum": ["akademik", "ibadah", "ekstrakurikuler"] },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "code", "startTime", "endTime"]
    },
    "LetterheadConfig": {
      "title": "LetterheadConfig",
      "description": "Kop surat and school identity configuration",
      "type": "object",
      "properties": {
        "yayasanName": { "type": "string" },
        "schoolName": { "type": "string" },
        "motto": { "type": "string" },
        "npsn": { "type": "string" },
        "nss": { "type": "string" },
        "accreditation": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "headmasterName": { "type": "string" },
        "headmasterNip": { "type": "string" },
        "counselorName": { "type": "string" },
        "counselorNiy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Master santri collection for SMA IT AL ITTIHAD"
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Real-time presence and prayer records"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/AttendanceCategory" },
      "description": "Configurable attendance sessions and prayer schedules"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/LetterheadConfig" },
      "description": "Kop surat, logo, and system configuration"
    }
  }
}
